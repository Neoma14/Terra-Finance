{
  "name": "@konsultan/desktop",
  "productName": "TERRA FINANCE",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "node scripts/launch-dev.js",
    "dist": "node scripts/prepare-deploy.js && electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "id.co.terrateknologidigital.terrafinance",
    "productName": "TERRA FINANCE",
    "npmRebuild": false,
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      { "from": "../../deploy/api-hoisted", "to": "api" },
      { "from": "../web/dist", "to": "web/dist" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
